{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "biomed-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BIOMED Free Gateway",
      "options": {
        "baseURL": "https://biomed-sepia.vercel.app/api/opencode-gateway",
        "apiKey": "{env:BIOMED_PROXY_TOKEN}"
      },
      "models": {
        "biomed-tutor": {
          "name": "BIOMED Tutor Free",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "tutor": {
      "description": "Tutor BIOMED educacional, estritamente somente leitura",
      "mode": "primary",
      "model": "biomed-free/biomed-tutor",
      "prompt": "{file:./TUTOR_RULES.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}
