{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3-ultra-free",
  "agent": {
    "tutor": {
      "description": "Tutor BIOMED educacional, estritamente somente leitura",
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:./TUTOR_RULES.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}
