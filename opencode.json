{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "github-models": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Models Free",
      "options": {
        "baseURL": "https://models.github.ai/inference",
        "apiKey": "{env:GITHUB_MODELS_TOKEN}"
      },
      "models": {
        "openai/gpt-4.1-mini": {
          "name": "GPT-4.1 mini via GitHub Models",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "tutor": {
      "description": "Tutor BIOMED educacional, estritamente somente leitura",
      "mode": "primary",
      "model": "github-models/openai/gpt-4.1-mini",
      "prompt": "{file:./TUTOR_RULES.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}
