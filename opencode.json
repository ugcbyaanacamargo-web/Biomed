{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local no GitHub Actions",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5:3b": {
          "name": "Qwen2.5 3B BIOMED",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  },
  "agent": {
    "tutor": {
      "description": "Tutor BIOMED educacional, estritamente somente leitura",
      "mode": "primary",
      "model": "ollama/qwen2.5:3b",
      "prompt": "{file:./TUTOR_RULES.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}
