# BIOMED — configuração de produção

# O plano gratuito do OpenCode exige execução dentro do próprio OpenCode.
# Railway mantém um único servidor OpenCode persistente e aquecido.
OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_DEADLINE_MS=12000
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
BIOMED_RUNTIME=railway

# Vercel encaminha o Tutor para o runtime persistente do Railway.
TUTOR_RAILWAY_URL=https://biomed-production-a6c6.up.railway.app/api/tutor

# Banco: destino correto é um projeto Supabase dedicado ao BIOMED.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

ALLOWED_ORIGIN=https://biomed-sepia.vercel.app

POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Use 1 somente durante benchmark controlado.
BIOMED_MODEL_BENCHMARK=0
