# BIOMED — configuração de produção
# Tutor IA: chamada direta ao OpenCode Zen. Não execute OpenCode CLI/serve/sandbox no servidor.
OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_DEADLINE_MS=12000
OPENCODE_MAX_OUTPUT_TOKENS=1100

# Banco: configure um projeto Supabase dedicado ao BIOMED.
# Enquanto a migração não for concluída, o código mantém compatibilidade com a base atual.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Limite de origem das funções.
ALLOWED_ORIGIN=https://biomed-sepia.vercel.app

# Analytics é opcional.
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Railway: benchmark opt-in do mesmo cliente Zen direto.
BIOMED_MODEL_BENCHMARK=0
