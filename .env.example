# O BIOMED funciona sem segredos obrigatórios para banco e para as IAs locais.
# Banco: Supabase RPC + publishable key protegidos por RLS e funções específicas.
# Tutor no navegador: WebLLM/WebGPU sem chave.
# Tutor OpenCode no GitHub Actions: Ollama + Qwen local sem chave.

# OPCIONAL: habilita também OpenCode Zen no endpoint /api/tutor.
OPENCODE_API_KEY=
OPENCODE_MODEL=nemotron-3.5-lightning-free

# OPCIONAL: limite explícito de origem para as funções Vercel.
ALLOWED_ORIGIN=https://biomed-sepia.vercel.app
