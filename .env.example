# BIOMED — hospedagem Vercel e Railway; sem processos OpenCode locais
# Somente a API interna do servidor lê a chave; nunca colocar no frontend.
OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_ZEN_TIMEOUT_MS=18000

# Mesmo código para Vercel Functions e Railway Node
BIOMED_RUNTIME=railway

# Supabase RPC
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGIN=https://biomed-sepia.vercel.app,https://biomed-production-a6c6.up.railway.app
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com
